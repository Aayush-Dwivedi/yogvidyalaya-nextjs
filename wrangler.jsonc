{
  "$schema": "nextjs-app/node_modules/wrangler/config-schema.json",
  "name": "yogvidyalaya-nextjs",
  "main": "nextjs-app/.open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "nextjs-app/.open-next/assets",
    "binding": "ASSETS"
  }
}
